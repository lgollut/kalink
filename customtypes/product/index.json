{
  "format": "custom",
  "id": "product",
  "label": "Product",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "name": {
        "type": "Text",
        "config": {
          "label": "Name",
          "placeholder": ""
        }
      },
      "description": {
        "type": "StructuredText",
        "config": {
          "label": "Description",
          "placeholder": "",
          "allowTargetBlank": true,
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl"
        }
      },
      "type": {
        "type": "Select",
        "config": {
          "label": "Type",
          "placeholder": "",
          "options": ["poster", "greetingsCard"]
        }
      },
      "images": {
        "type": "Group",
        "config": {
          "label": "Images",
          "repeat": true,
          "fields": {
            "image": {
              "type": "Image",
              "config": {
                "label": "Image",
                "constraint": {
                  "width": null,
                  "height": null
                },
                "thumbnails": []
              }
            }
          }
        }
      },
      "metadata": {
        "type": "Group",
        "config": {
          "label": "Metadata",
          "repeat": true,
          "fields": {
            "key": {
              "type": "Select",
              "config": {
                "label": "Key",
                "placeholder": "",
                "options": ["measure", "medium", "year"]
              }
            },
            "value": {
              "type": "Text",
              "config": {
                "label": "Value",
                "placeholder": ""
              }
            }
          }
        }
      }
    },
    "Product links": {
      "product": {
        "type": "IntegrationFields",
        "config": {
          "catalog": "kalink--product_catalog",
          "label": "Product catalog",
          "placeholder": "Select a Stripe Product from the catalog"
        }
      },
      "shipping": {
        "type": "IntegrationFields",
        "config": {
          "catalog": "kalink--shipping_rates",
          "label": "Shipping rates",
          "placeholder": "Select a shipping rate for this product"
        }
      },
      "variants": {
        "type": "Group",
        "config": {
          "label": "Variants",
          "repeat": true,
          "fields": {
            "product": {
              "type": "Link",
              "config": {
                "label": "Product",
                "select": "document",
                "repeat": false,
                "customtypes": ["product"]
              }
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "metaTitle": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "metaDescription": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "metaImage": {
        "config": {
          "label": "Meta Image",
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  }
}

    "clsx": "^2.1.1",
    "i18next": "^24.2.3",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react": "^0.473.0",
    "motion": "^11.18.2",
    "next": "15.2.0-canary.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.55.0",
    "react-i18next": "^15.4.1",
    "resend": "^4.2.0",

{
  "name": "kalink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev --webpack\" \"pnpm:slicemachine\" --names \"next,slicemachine\" --prefix-colors blue,magenta",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "pnpm run eslint",
    "slicemachine": "start-slicemachine",
    "eslint": "eslint .",
    "eslint:fix": "pnpm run eslint --fix",
    "prettier": "prettier '**/!(CHANGELOG|prismicio-types.d).@(ts|tsx|md|mdx)' --list-different",
    "prettier:fix": "pnpm run prettier --write",
    "tsc": "next typegen && tsc --noEmit",
    "validate": "npm-run-all eslint prettier --continue-on-error",
    "format": "npm-run-all eslint:fix prettier:fix --continue-on-error"
  },
  "dependencies": {
    "@prismicio/client": "^7.23.1",
    "@prismicio/next": "^3.0.0",
    "@prismicio/react": "^3.5.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@react-email/render": "^2.3.1",
    "@uidotdev/usehooks": "^2.4.1",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vercel/analytics": "^2.0.1",
    "@vis.gl/react-google-maps": "^1.10.2",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "resend": "^6.39.0",
    "simplebar-react": "^3.3.2",
    "stripe": "^23.2.0"
  },
  "devDependencies": {
    "@slicemachine/adapter-next": "^0.3.100",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/css-utils": "^0.1.6",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.7.1",
    "concurrently": "^10.0.7",
    "eslint": "~9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.10.1",
    "slice-machine-ui": "^2.21.6",
    "type-fest": "^6.0.3",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.x"
  }
}
